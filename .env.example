# LA & SAVVY Mtaani Errands • LA & Savvy Limited • Rongai, Nairobi, Kenya
# Copy into Vercel → Project → Settings → Environment Variables (and .env.local for local dev).
# Leave "Will be provided later" until you receive each key — the app runs in demo mode
# and treats that placeholder as "not configured".

# Supabase (Auth, Database, Storage, Realtime) — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="Will be provided later"
NEXT_PUBLIC_SUPABASE_ANON_KEY="Will be provided later"
SUPABASE_SERVICE_ROLE_KEY="Will be provided later"       # server only — lets M-Pesa callbacks mark orders Paid

# Google Maps JavaScript API — enable: Maps JavaScript API, Places API, Distance Matrix API, Directions API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="Will be provided later"

# Safaricom Daraja — M-Pesa STK Push (until set, customers see manual Till 123456)
MPESA_ENV="sandbox"                                      # sandbox | production
MPESA_CONSUMER_KEY="Will be provided later"
MPESA_CONSUMER_SECRET="Will be provided later"
MPESA_PASSKEY="Will be provided later"
MPESA_SHORTCODE="Will be provided later"

# Optional: public URL used for the M-Pesa callback (defaults to the request origin)
NEXT_PUBLIC_SITE_URL="https://la-savvy.vercel.app"

# ── Legacy Expo mobile app (apps/mobile/.env) ─────────────────────────────────
EXPO_PUBLIC_API_URL="Will be provided later"
EXPO_PUBLIC_SUPABASE_URL="Will be provided later"
EXPO_PUBLIC_SUPABASE_ANON_KEY="Will be provided later"
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY="Will be provided later"
