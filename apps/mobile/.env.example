# Mtaani Errands • LA & Savvy Limited • Rongai, Nairobi, Kenya
# Copy into Vercel → Project → Settings → Environment Variables (admin portal)
# and into apps/mobile/.env (Expo app). Leave "Will be provided later" until you
# receive each key — the apps run in demo mode and treat it as "not configured".

# ── Admin portal (apps/admin) ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="Will be provided later"            # e.g. https://mtaani-errands.vercel.app
MAIN_ADMIN_EMAIL="admin@lasavvy.co.ke"
MAIN_ADMIN_PASSWORD="Will be provided later"             # REQUIRED before going live (demo: mtaani-demo)
ADMIN_SESSION_SECRET="Will be provided later"            # 32+ random characters
CRON_SECRET="Will be provided later"                     # protects /api/cron/supplier-reminders

# Supabase (Postgres, Auth, Storage, Realtime)
NEXT_PUBLIC_SUPABASE_URL="Will be provided later"
SUPABASE_ANON_KEY="Will be provided later"
SUPABASE_SERVICE_ROLE_KEY="Will be provided later"       # server only — never expose to clients

# Google Maps Platform (Directions API with traffic)
GOOGLE_MAPS_API_KEY="Will be provided later"

# Safaricom Daraja — M-Pesa STK Push
MPESA_ENV="sandbox"                                      # sandbox | production
MPESA_CONSUMER_KEY="Will be provided later"
MPESA_CONSUMER_SECRET="Will be provided later"
MPESA_SHORTCODE="Will be provided later"
MPESA_PASSKEY="Will be provided later"
MPESA_PAYBILL_NUMBER="Will be provided later"

# PayPal
PAYPAL_CLIENT_ID="Will be provided later"
PAYPAL_CLIENT_SECRET="Will be provided later"

# Cards — Stripe or Paystack (pick one)
STRIPE_SECRET_KEY="Will be provided later"
STRIPE_PUBLISHABLE_KEY="Will be provided later"
PAYSTACK_SECRET_KEY="Will be provided later"
PAYSTACK_PUBLIC_KEY="Will be provided later"

# Supplier expiry reminder emails (Resend)
RESEND_API_KEY="Will be provided later"
EMAIL_FROM="Mtaani Errands <hello@lasavvy.co.ke>"

# ── Mobile app (apps/mobile/.env) ─────────────────────────────────────────────
EXPO_PUBLIC_API_URL="Will be provided later"             # your Vercel URL, e.g. https://mtaani-errands.vercel.app
EXPO_PUBLIC_SUPABASE_URL="Will be provided later"
EXPO_PUBLIC_SUPABASE_ANON_KEY="Will be provided later"
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY="Will be provided later"
